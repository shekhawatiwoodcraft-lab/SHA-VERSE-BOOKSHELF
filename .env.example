# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Public Configuration (works identically in Google AI Studio & Lovable)
VITE_SUPABASE_URL="https://gkmyhgebjqkdvjzgbrhr.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_rgJcImQqgXg8NJMKRqvFyg_y7g1jXfE"
NEXT_PUBLIC_SUPABASE_URL="https://gkmyhgebjqkdvjzgbrhr.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_rgJcImQqgXg8NJMKRqvFyg_y7g1jXfE"

# Server-Side Supabase Configuration (configure secret keys in Secrets panel only)
SUPABASE_URL="https://gkmyhgebjqkdvjzgbrhr.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_rgJcImQqgXg8NJMKRqvFyg_y7g1jXfE"
SUPABASE_JWKS_URL="https://gkmyhgebjqkdvjzgbrhr.supabase.co/auth/v1/.well-known/jwks.json"
